<!DOCTYPE html>
<html>
  <head>
    <title>SuperAdmin | Chatwoot</title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>

    <style>
      :root {
        --bg-midnight: hsl(222, 47%, 5%);
        --cyan-neon: hsl(185, 100%, 50%);
        --magenta-neon: hsl(300, 100%, 50%);
      }

      body {
        background: var(--bg-midnight);
        overflow: hidden;
      }

      #neural-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
      }

      main {
        position: relative;
        z-index: 10;
      }

      /* Title glow */

      .neon-title {
        text-shadow:
          0 0 6px rgba(0,255,255,0.6),
          0 0 14px rgba(0,255,255,0.4),
          0 0 30px rgba(0,255,255,0.2);
      }

      /* Glass login card */

      .login-card{
        background: rgba(10,15,25,0.85);
        border-radius: 22px;

        border: 1px solid rgba(255,255,255,0.05);

        backdrop-filter: blur(25px);

        box-shadow:
          0 20px 80px rgba(0,0,0,0.9),
          0 0 30px rgba(0,255,255,0.08);

        position: relative;
      }

      /* Neon button */

      .btn-neon{
        background: linear-gradient(
          135deg,
          #00ffff 0%,
          #ff00ff 100%
        );

        color:#020617;
        font-weight:700;
        letter-spacing:.08em;

        transition:.25s;
      }

      .btn-neon:hover{
        transform: translateY(-2px);
        box-shadow:
          0 0 20px rgba(0,255,255,0.5),
          0 0 40px rgba(255,0,255,0.25);
      }

      /* Inputs */

      input{
        background: rgba(0,0,0,0.35) !important;
        border:1px solid rgba(255,255,255,0.1) !important;
      }

      input:focus{
        border-color:#00ffff !important;
        box-shadow:0 0 8px rgba(0,255,255,0.4);
      }

    </style>
  </head>

  <body>

    <canvas id="neural-canvas"></canvas>

    <div class="h-full w-full antialiased">
      <main class="flex flex-col min-h-screen w-full py-20 sm:px-6 lg:px-8">

        <section class="max-w-5xl mx-auto">

          <img src="/brand-assets/logo.svg" alt="Chatwoot" class="mx-auto h-8 w-auto block dark:hidden">
          <img src="/brand-assets/logo_dark.svg" alt="Chatwoot" class="mx-auto h-8 w-auto hidden dark:block">

          <h2 class="mt-6 text-center text-3xl font-semibold text-white tracking-wide neon-title">
            Howdy, admin 👋
          </h2>

        </section>

        <section class="login-card sm:mx-auto mt-11 sm:w-full sm:max-w-lg p-11 mb-8">

          <div>

            <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>

              <% if flash[:error].present? %>
                <div data-alert class="rounded-md bg-red-500 p-4 text-white text-sm mb-5">
                  <%= flash[:error] %>
                </div>
              <% end %>

              <div class="mb-5">
                <label class="flex justify-between text-sm font-medium text-white">
                  Email Address
                </label>

                <div class="mt-1">
                  <%= f.email_field :email,
                    autofocus: true,
                    autocomplete: "email",
                    placeholder: "Email eg: someone@example.com",
                    class: "block w-full rounded-md px-3 py-3 appearance-none shadow-sm text-white outline-none" %>
                </div>
              </div>

              <div class="mb-5">
                <label class="flex justify-between text-sm font-medium text-white">
                  Password
                </label>

                <div class="mt-1">
                  <%= f.password_field :password,
                    autocomplete: "current-password",
                    placeholder: "Password",
                    class: "block w-full rounded-md px-3 py-3 appearance-none shadow-sm text-white outline-none" %>
                </div>
              </div>

              <button
                type="submit"
                class="btn-neon flex items-center w-full justify-center rounded-md py-3 px-3 text-base font-medium cursor-pointer">

                <span>Login</span>

              </button>

            <% end %>

          </div>

        </section>

      </main>
    </div>

<script>

document.addEventListener("DOMContentLoaded", () => {

const canvas = document.getElementById('neural-canvas');
const ctx = canvas.getContext('2d');

let particles = [];
const particleCount = 60;
const connectionDistance = 150;

window.addEventListener('resize', () => {
  canvas.width = innerWidth;
  canvas.height = innerHeight;
});

class Particle {
  constructor(){
    this.x = Math.random() * innerWidth;
    this.y = Math.random() * innerHeight;
    this.vx = (Math.random() - 0.5) * 0.35;
    this.vy = (Math.random() - 0.5) * 0.35;
  }

  update(){
    this.x += this.vx;
    this.y += this.vy;

    if(this.x < 0 || this.x > innerWidth) this.vx *= -1;
    if(this.y < 0 || this.y > innerHeight) this.vy *= -1;
  }
}

function init(){
  canvas.width = innerWidth;
  canvas.height = innerHeight;

  for(let i=0;i<particleCount;i++){
    particles.push(new Particle());
  }

  animate();
}

function animate(){

  ctx.fillStyle = "#020617";
  ctx.fillRect(0,0,canvas.width,canvas.height);

  particles.forEach((p,i)=>{

    p.update();

    ctx.fillStyle = "cyan";
    ctx.beginPath();
    ctx.arc(p.x,p.y,2,0,Math.PI*2);
    ctx.fill();

    for(let j=i+1;j<particles.length;j++){

      const p2 = particles[j];
      const dist = Math.hypot(p.x-p2.x,p.y-p2.y);

      if(dist < connectionDistance){

        ctx.strokeStyle = "rgba(0,255,255,0.15)";
        ctx.beginPath();
        ctx.moveTo(p.x,p.y);
        ctx.lineTo(p2.x,p2.y);
        ctx.stroke();

      }
    }

  });

  requestAnimationFrame(animate);
}

init();

});

</script>

  </body>
</html>
