# Dockerfile.dev.optimized
# Multi-stage build with optimized layer caching for faster development iteration

# ============================================================================
# Stage 1: Base image with system dependencies
# ============================================================================
FROM ruby:3.4.4-slim AS base

ENV RAILS_ENV=development \
    NODE_ENV=development \
    BUNDLE_PATH=/bundle \
    RAILS_LOG_TO_STDOUT=true

# Install all system dependencies in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ca-certificates \
    pkg-config \
    libpq-dev \
    libpq5 \
    libvips \
    postgresql-client \
    ruby-dev \
    python3 \
    tmux \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

# Install overmind (process manager)
RUN curl -fsSL https://github.com/DarthSim/overmind/releases/download/v2.4.0/overmind-v2.4.0-linux-amd64.gz \
    | gunzip -c > /usr/local/bin/overmind \
    && chmod +x /usr/local/bin/overmind

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install bundler
RUN gem install bundler

WORKDIR /app

# ============================================================================
# Stage 2: Dependencies layer (cached unless package files change)
# ============================================================================
FROM base AS dependencies

# Copy only dependency definition files (for layer caching)
COPY Gemfile Gemfile.lock ./
COPY package.json pnpm-lock.yaml ./

# Install Ruby gems
# This layer will be cached unless Gemfile changes
RUN bundle install --jobs 4 --retry 3

# Install Node.js dependencies
# This layer will be cached unless package.json or pnpm-lock.yaml changes.
#
# --shamefully-hoist is required here: the compose file mounts an anonymous
# volume over /app/node_modules, and pnpm's default symlinked layout does not
# survive that. Installing hoisted at build time is what lets the vite container
# start straight into the dev server instead of re-installing on every boot.
RUN pnpm config set node-linker hoisted && \
    pnpm install --no-frozen-lockfile --shamefully-hoist

# ============================================================================
# Stage 3: Development runtime
# ============================================================================
FROM base AS development

# Copy installed dependencies from dependencies stage
COPY --from=dependencies /bundle /bundle
COPY --from=dependencies /app/node_modules /app/node_modules

# The application code will be mounted as a volume at runtime
# This means we don't copy the application code into the image
# allowing for instant reflection of code changes

EXPOSE 3000 3036

# Default command (can be overridden in docker-compose)
CMD ["bash"]